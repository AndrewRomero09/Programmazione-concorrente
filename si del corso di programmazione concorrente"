[32m+[m[32m        pid = os.fork()[m
[32m+[m[32m    except OSError:[m
[32m+[m[32m        # a) Errore di sdoppiamento[m
[32m+[m[32m        print("[ERRORE] Generazione del processo figlio fallita")[m
