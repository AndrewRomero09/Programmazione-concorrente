[32m+[m[32mprint("  v -> 10 lampeggi LED VERDE  (0.3s)")[m
[32m+[m[32mprint("  r -> 10 lampeggi LED ROSSO  (0.7s)")[m
[32m+[m[32mprint("  g -> 10 lampeggi LED GIALLO (1.2s)")[m
