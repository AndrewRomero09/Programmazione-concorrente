[32m+[m
[32m+[m[32m    if pid == 0:[m
[32m+[m[32m        # b) Codice eseguito esclusivamente dal processo FIGLIO[m
[32m+[m[32m        if led == 1:[m
[32m+[m[32m            esegui_lampeggio(colore_led, intervallo)[m
[32m+[m[32m        elif led == 2:[m
[32m+[m[32m            esegui_lampeggio(colore_led, intervallo)[m
[32m+[m[32m        elif led == 3:[m
[32m+[m[32m            esegui_lampeggio(colore_led, intervallo)[m
[32m+[m[32m        else:[m
[32m+[m[32m            print(f"[FIGLIO] Errore: LED non riconosciuto.")[m
[32m+[m[32m            sys.exit(1)[m
[32m+[m
[32m+[m[32m        # IMPORTANTE: Termina il processo figlio per evitare che ritorni nel ciclo del padre[m
[32m+[m[32m        sys.exit(0)[m
[32m+[m[32m    else:[m
[32m+[m[32m        # c) Codice eseguito esclusivamente dal processo PADRE[m
[32m+[m[32m        # Per evitare processi "zombie" e forzare la sincronizzazione,[m
[32m+[m[32m        # il padre attende attivamente che il figlio termini prima di chiedere un nuovo comando.[m
[32m+[m[32m        print(f"[PADRE] Figlio avviato (PID: {pid}). Attendo il completamento...")[m
[32m+[m[41m        [m
[32m+[m[32m        # os.wait() corrisponde a wait(NULL) in C e restituisce una tupla (pid, status)[m
[32m+[m[32m        pid_archiviato, stato = os.wait()[m
[32m+[m[41m        [m
[32m+[m[32m        print(f"[PADRE] Il figlio {pid_archiviato} ha terminato. Ora puoi inserire un nuovo comando.\n")[m
