[32m+[m[32m    if comando == 'q' or comando == 'Q':[m
[32m+[m[32m        print("Chiusura del programma principale. Arrivederci!")[m
[32m+[m[32m        break[m
[32m+[m
[32m+[m[32m    # Impostazione della variabile in base al comando[m
[32m+[m[32m    if comando == 'v' or comando == 'V':[m
[32m+[m[32m        led = 1[m
[32m+[m[32m        colore_led = "VERDE"[m
[32m+[m[32m        intervallo = 0.3[m
[32m+[m[32m    elif comando == 'r' or comando == 'R':[m
